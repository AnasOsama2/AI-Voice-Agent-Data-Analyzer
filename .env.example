# ==============================================================================
# AI Voice Data Analyzer - Environment Configuration
# ==============================================================================

# Required: Groq API Key (Get your free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: AI Models Configuration
# Whisper Speech-to-Text Model (e.g., whisper-large-v3-turbo, whisper-large-v3)
WHISPER_MODEL=whisper-large-v3-turbo

# Data Analyst LLM Model (e.g., qwen/qwen3.6-27b, llama-3.3-70b-versatile)
LLM_MODEL=qwen/qwen3.6-27b
